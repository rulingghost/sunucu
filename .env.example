# ==============================================================================
# NOVAQ SERVERS - VERCEL POSTGRES & VERCEL BLOB YAPILANDIRMASI
# ==============================================================================
# Vercel Dashboard -> Storage sayfasından oluşturduğunuz kaynakların
# bağlantı bilgilerini buraya yapıştırabilirsiniz.
#
# Canlı dağıtımda (Vercel deploy) bu değerler Vercel tarafından
# otomatik olarak Environment Variables alanına eklenir.
# ==============================================================================

# 1. Vercel Postgres / Neon İlişkisel Veritabanı
# Format: postgres://default:[PASSWORD]@[ENDPOINT-POOLER].postgres.vercel-storage.com:5432/verceldb?sslmode=require
POSTGRES_URL="postgres://default:your_password@ep-cool-fog-123456-pooler.eu-central-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
DATABASE_URL="postgres://default:your_password@ep-cool-fog-123456-pooler.eu-central-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# 2. Vercel Blob Nesne Depolama (Dekont, Dosya, Bilet Ekleri)
# Vercel Dashboard -> Storage -> Blob -> Settings -> Tokens alanından kopyalayınız.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. İsteğe Bağlı Supabase Geriye Uyumluluk (Kullanılmıyorsa boş bırakılabilir)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
